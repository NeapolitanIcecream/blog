{
  "name": "voile-tech",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/prepare-cloudflare-output.mjs && node scripts/build-search-index.mjs",
    "preview": "astro preview",
    "test": "pnpm check && pnpm build && node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=blog"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.5",
    "katex": "0.16.22",
    "mermaid": "11.16.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.1.2",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  }
}
