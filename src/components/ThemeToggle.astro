<button class="theme-toggle" type="button" aria-label="切换为深色主题" title="切换主题">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
  <span class="visually-hidden">切换主题</span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')

  function syncThemeButton() {
    if (!toggle) return
    const isDark = document.documentElement.dataset.theme === 'dark'
    toggle.setAttribute('aria-label', isDark ? '切换为浅色主题' : '切换为深色主题')
    toggle.setAttribute('title', isDark ? '切换为浅色主题' : '切换为深色主题')
  }

  syncThemeButton()

  toggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = nextTheme
    document.documentElement.style.colorScheme = nextTheme
    localStorage.setItem('theme', nextTheme)
    syncThemeButton()
    window.dispatchEvent(new CustomEvent('voile:theme-change', { detail: nextTheme }))
  })
</script>
