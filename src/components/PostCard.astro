---
import type { Post } from '../utils/posts'
import { formatDate, formatDateISO, getPostUrl, getReadingMinutes, getTagUrl } from '../utils/posts'

interface Props {
  post: Post
  headingLevel?: 2 | 3
}

const { post, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3'
---

<article class="post-card" data-pagefind-ignore>
  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime={formatDateISO(post.data.publishDate)}
        >{formatDate(post.data.publishDate)}</time
      >
      <span>{getReadingMinutes(post)} 分钟</span>
    </div>
    <Heading class="post-card__title">
      <a href={getPostUrl(post)}>{post.data.title}</a>
    </Heading>
    <p>{post.data.description}</p>
  </div>

  {
    post.data.tags.length > 0 && (
      <div class="post-card__footer">
        <ul class="tag-list" aria-label="文章标签">
          {post.data.tags.slice(0, 3).map((tag) => (
            <li>
              <a href={getTagUrl(tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>
