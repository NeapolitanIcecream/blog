---
import { NAVIGATION, SITE } from '../config'

const year = new Date().getUTCFullYear()
---

<footer class="site-footer">
  <div class="site-footer__grid shell">
    <div class="site-footer__intro">
      <a class="footer-brand" href="/">{SITE.title}</a>
      <p>{SITE.description}</p>
    </div>

    <nav aria-label="页脚导航">
      <h2>浏览</h2>
      <ul>
        {
          NAVIGATION.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/search/">搜索</a></li>
      </ul>
    </nav>

    <nav aria-label="订阅与源代码">
      <h2>连接</h2>
      <ul>
        <li><a href="/rss.xml">RSS 订阅</a></li>
        <li><a href={SITE.repository} rel="external">GitHub 源码</a></li>
      </ul>
    </nav>
  </div>

  <div class="site-footer__meta shell">
    <p>© {year} {SITE.author}。内容版权归作者所有。</p>
    <p>Astro 构建 · Cloudflare Pages 托管</p>
  </div>
</footer>
