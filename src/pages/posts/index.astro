---
import PostCard from '../../components/PostCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getListedPosts } from '../../utils/posts'

const posts = await getListedPosts()
---

<BaseLayout title="文章" description="Voile 的全部文章。">
  <header class="page-header">
    <div class="page-header__grid shell">
      <div>
        <h1>文章</h1>
      </div>
    </div>
  </header>

  <section class="archive shell" aria-label="文章列表">
    <div class="archive__summary">
      <p><strong>{posts.length}</strong> 篇文章</p>
      <a class="text-link" href="/search/">搜索全文</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="archive__list">
          {posts.map((post) => (
            <PostCard post={post} headingLevel={2} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>还没有文章。</h2>
        </div>
      )
    }
  </section>
</BaseLayout>
