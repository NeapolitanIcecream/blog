---
import PostCard from '../../components/PostCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedPosts } from '../../utils/posts'

const posts = await getPublishedPosts()
---

<BaseLayout title="全部文章" description="Voile 技术博客的全部公开文章。">
  <header class="page-header">
    <div class="page-header__grid shell">
      <div>
        <p class="eyebrow">文章归档</p>
        <h1>全部文章</h1>
      </div>
      <p>按发布时间排列的工程实践、系统设计与问题求解记录。</p>
    </div>
  </header>

  <section class="archive shell" aria-label="文章列表">
    <div class="archive__summary">
      <p><strong>{posts.length}</strong> 篇公开文章</p>
      <a class="text-link" href="/search/">搜索全文</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="archive__list">
          {posts.map((post) => (
            <PostCard post={post} headingLevel={2} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p class="eyebrow">暂无内容</p>
          <h2>第一篇文章还在路上。</h2>
          <p>在 `src/content/posts/` 新建 Markdown 文件后，它会出现在这里。</p>
        </div>
      )
    }
  </section>
</BaseLayout>
