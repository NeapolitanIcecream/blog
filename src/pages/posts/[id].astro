---
import { render } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import { getPublishedPosts, isListedPost, type Post } from '../../utils/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const listedPosts = posts.filter(isListedPost)

  return posts.map((post) => {
    const listedIndex = listedPosts.findIndex((listedPost) => listedPost.id === post.id)

    return {
      params: { id: post.id },
      props: {
        post,
        previous: listedIndex >= 0 ? listedPosts[listedIndex + 1] : undefined,
        next: listedIndex >= 0 ? listedPosts[listedIndex - 1] : undefined,
      },
    }
  })
}

interface Props {
  post: Post
  previous?: Post
  next?: Post
}

const { post, previous, next } = Astro.props
const { Content, headings } = await render(post)
---

<PostLayout {post} {headings} {previous} {next}>
  <Content />
</PostLayout>
