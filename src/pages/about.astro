---
import { SITE } from '../config'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="关于" description="关于 Voile。">
  <header class="page-header">
    <div class="page-header__grid shell">
      <div>
        <h1>关于</h1>
      </div>
    </div>
  </header>

  <div class="about-page shell">
    <div class="prose about-page__content">
      <p class="about-page__intro">你好，我是 Voile。这里是我的个人博客。</p>
      <p>
        我主要记录软件开发、工具和日常遇到的问题。文章以中文为主，需要时会使用代码、图表和公式。
      </p>

      <h2>链接</h2>
      <ul>
        <li><a href="/rss.xml">RSS 订阅</a></li>
        <li><a href={SITE.repository}>GitHub</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
