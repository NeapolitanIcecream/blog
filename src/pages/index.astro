---
import PostCard from '../components/PostCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPublishedPosts, getTagSummary, getTagUrl } from '../utils/posts'

const posts = await getPublishedPosts()
const latestPosts = posts.slice(0, 6)
const tags = getTagSummary(posts).slice(0, 6)
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero__grid shell">
      <div class="home-hero__content">
        <h1>你好，我是 Voile。</h1>
        <p class="home-hero__lead">这里是我的个人博客，主要记录软件开发、工具和一些想法。</p>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">最新文章</h2>
      <a class="text-link text-link--arrow" href="/posts/">全部文章</a>
    </div>
    {
      latestPosts.length > 0 ? (
        <div class="post-grid">
          {latestPosts.map((post) => (
            <PostCard post={post} headingLevel={3} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>还没有文章。</h3>
        </div>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section class="section section--bordered shell" aria-labelledby="topics-heading">
        <div class="section-heading">
          <h2 id="topics-heading">标签</h2>
          <a class="text-link text-link--arrow" href="/tags/">
            全部标签
          </a>
        </div>
        <ul class="topic-cloud">
          {tags.map((tag) => (
            <li>
              <a href={getTagUrl(tag.name)}>
                <span>{tag.name}</span>
                <small>{tag.count.toString().padStart(2, '0')}</small>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
